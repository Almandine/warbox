---
import '@fontsource-variable/inter';
import '@fontsource/rajdhani/500.css';
import '@fontsource/rajdhani/600.css';
import '@fontsource/rajdhani/700.css';
import '../styles/global.css';

import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_TAGLINE, SITE_DESCRIPTION, CF_ANALYTICS_TOKEN } from '../consts';

interface Props {
  /** Page title without the site suffix. Omit on the home page. */
  title?: string;
  description?: string;
}

const { title, description = SITE_DESCRIPTION } = Astro.props;

const fullTitle = title ? `${title} · ${SITE_TITLE}` : `${SITE_TITLE} — ${SITE_TAGLINE}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://warbox.org');

// Social preview (Facebook, forums): the home cover artwork, flattened onto the
// site's paper colour because many previews draw transparency as black.
const coverFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/cover/*.{png,jpg,jpeg,webp,avif}', {
  eager: true,
});
const coverSrc = Object.keys(coverFiles).sort().map((key) => coverFiles[key]!.default)[0];
const ogImage = coverSrc
  ? await getImage({ src: coverSrc, width: 1200, format: 'jpeg', background: '#faf8f4' })
  : undefined;
const ogImageUrl = ogImage ? new URL(ogImage.src, Astro.site ?? 'https://warbox.org').href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    {
      /* Cloudflare Web Analytics — cookie-less, no consent banner needed.
         Installed by hand rather than auto-injected at the edge, because
         warbox.org resolves straight to GitHub Pages (DNS-only, not proxied),
         so Cloudflare never sees the response. `is:inline` keeps Astro from
         touching a third-party tag. */
      CF_ANALYTICS_TOKEN && (
        <script
          is:inline
          type="module"
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${CF_ANALYTICS_TOKEN}"}`}
        />
      )
    }
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot name="cover" />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <style>
      body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }

      .skip {
        position: absolute;
        left: -9999px;
        z-index: 100;
        padding: 0.75rem 1.25rem;
        background: var(--wg-accent);
        color: var(--wg-on-accent);
        font-weight: 700;
      }

      .skip:focus {
        left: 1rem;
        top: 1rem;
      }
    </style>
  </body>
</html>
