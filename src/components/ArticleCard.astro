---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { CATEGORIES, readingTime, type Article } from '../lib/articles';
import { formatDate } from '../lib/games';

interface Props {
  article: Article;
}

const { article } = Astro.props;
const { title, description, date, category, cover } = article.data;
---

<article class="card" data-category={category}>
  {
    cover && (
      <a class="card__media" href={`/articles/${article.id}/`} tabindex="-1" aria-hidden="true">
        <Image src={cover} alt="" widths={[400, 800]} sizes="(min-width: 900px) 380px, 100vw" loading="lazy" />
      </a>
    )
  }

  <div class="card__body">
    <p class="card__cat">{CATEGORIES[category]}</p>
    <h3 class="card__title">
      <a href={`/articles/${article.id}/`}>{title}</a>
    </h3>
    <p class="card__desc">{description}</p>
    <p class="card__meta">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      <span aria-hidden="true">·</span>
      <span><Icon name="clock" size="0.9em" /> {readingTime(article.body)}</span>
    </p>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--wg-border);
    border-radius: var(--radius);
    background: var(--wg-surface);
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  .card:hover,
  .card:focus-within {
    border-color: var(--wg-accent);
  }

  .card__media {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(0.92) brightness(1.04);
    transition:
      filter 0.45s ease,
      transform 0.6s ease;
  }

  .card:hover .card__media :global(img),
  .card:focus-within .card__media :global(img) {
    filter: grayscale(0) contrast(1) brightness(1);
    transform: scale(1.03);
  }

  .card__body {
    padding: 1.25rem;
  }

  .card__cat {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--wg-accent);
  }

  .card__title {
    margin-top: 0.5rem;
    font-size: 1.125rem;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .card__title a {
    text-decoration: none;
  }

  /* Whole card is the click target, without nesting links. */
  .card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card__desc {
    margin-top: 0.625rem;
    font-size: 0.9375rem;
    color: var(--wg-muted);
  }

  .card__meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--wg-border);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--wg-faint);
  }
</style>
