---
import { statSync } from 'node:fs';
import { join } from 'node:path';
import Icon from './Icon.astro';

interface Props {
  /** Site-absolute path of the file, e.g. "/downloads/companions/pc-normandy-44.xlsx". */
  href: string;
  label?: string;
  /** Companion version, shown next to the size. */
  version?: string;
  /** Renders as a quieter secondary button — for lists of alternative formats. */
  variant?: 'primary' | 'subtle';
}

const { href, label = 'Download the companion', version, variant = 'primary' } = Astro.props;

const file = href.split('/').pop() ?? href;

/**
 * File size is read from disk at build time — no hand-maintained numbers that
 * silently go stale when the spreadsheet is updated. A missing file renders a
 * disabled button instead of failing the build, so a game entry can be added
 * before its download is uploaded.
 *
 * Resolved from the working directory, not from `import.meta.url`: in a build
 * this component is bundled into a chunk elsewhere on disk, so a path relative
 * to the module silently misses and every download reads as missing.
 */
function readSize(): number | null {
  try {
    return statSync(join(process.cwd(), 'public', href)).size;
  } catch {
    return null;
  }
}

/** KB below a megabyte — "0.00 MB" tells the reader nothing. */
function formatSize(bytes: number): string {
  return bytes < 1024 * 1024
    ? `${Math.max(1, Math.round(bytes / 1024))} KB`
    : `${(bytes / 1024 / 1024).toFixed(1)} MB`;
}

const bytes = readSize();
const size = bytes === null ? null : formatSize(bytes);
const extension = file.split('.').pop()?.toUpperCase() ?? 'FILE';
---

{
  bytes === null ? (
    <div class="dl dl--missing">
      <Icon name="download" size="1.25rem" />
      <div>
        <strong>{label}</strong>
        <span class="dl__meta">Not uploaded yet · {file}</span>
      </div>
    </div>
  ) : (
    <a class:list={['dl', { 'dl--subtle': variant === 'subtle' }]} href={href} download>
      <Icon name="download" size="1.25rem" />
      <div>
        <strong>{label}</strong>
        <span class="dl__meta">
          {extension} · {size}
          {version && ` · v${version}`}
        </span>
      </div>
    </a>
  )
}

<style>
  .dl {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    width: 100%;
    padding: 1rem 1.25rem;
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: var(--wg-accent);
    color: var(--wg-on-accent);
    text-decoration: none;
    transition: background-color 0.18s ease;
  }

  .dl:hover {
    background: var(--wg-accent-strong);
  }

  .dl strong {
    display: block;
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .dl__meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    opacity: 0.85;
  }

  .dl--missing {
    background: var(--wg-surface);
    border-color: var(--wg-border);
    color: var(--wg-muted);
    cursor: not-allowed;
  }

  .dl--subtle {
    background: var(--wg-surface);
    border-color: var(--wg-border);
    color: var(--wg-ink);
  }

  .dl--subtle:hover {
    background: var(--wg-bg);
    border-color: var(--wg-accent);
  }
</style>
