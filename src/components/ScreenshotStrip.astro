---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';

export interface StripItem {
  image: ImageMetadata;
  caption?: string;
  gameTitle: string;
  gameId: string;
  seriesName: string;
  accent: string;
}

interface Props {
  items: StripItem[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <section class="strip">
      <div class="wrap strip__head">
        <h2 class="section-title">
          <Icon name="image" size="1em" class="strip__icon" /> What they look like
        </h2>
        <div class="section-rule" />
        <p class="strip__lead">
          Sheets from the published companions. Every one is a real screen from the spreadsheet, not
          a mock-up.
        </p>
      </div>

      <div class="strip__rail no-scrollbar">
        {items.map((item) => (
          <article class="slide" style={`--accent: ${item.accent}`}>
            <a class="slide__media" href={`/games/${item.gameId}/`}>
              <Image
                src={item.image}
                alt={`${item.gameTitle} companion`}
                widths={[700, 1400]}
                sizes="(min-width: 768px) 700px, 85vw"
                loading="lazy"
              />
              <span class="slide__tag">{item.seriesName}</span>
            </a>
            <div class="slide__body">
              <h3 class="slide__title">{item.gameTitle}</h3>
              {item.caption && <p class="slide__caption">{item.caption}</p>}
            </div>
          </article>
        ))}
        {/* Lets the last card snap clear of the viewport edge. */}
        <div class="strip__end" aria-hidden="true" />
      </div>

      <p class="strip__hint">
        <Icon name="arrows-h" size="1em" /> Scroll sideways
      </p>
    </section>
  )
}

<style>
  .strip {
    padding-block: 5rem;
    border-top: 1px solid var(--wg-border);
    overflow: hidden;
  }

  .strip__icon {
    color: var(--wg-accent);
  }

  .strip__lead {
    margin-top: 1.5rem;
    max-width: 60ch;
    color: var(--wg-muted);
  }

  .strip__rail {
    display: flex;
    gap: 1.5rem;
    margin-top: 2.5rem;
    padding-inline: 1rem;
    padding-bottom: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-left: 1rem;
    overscroll-behavior-x: contain;
  }

  @media (min-width: 640px) {
    .strip__rail {
      padding-inline: 2rem;
      scroll-padding-left: 2rem;
    }
  }

  .slide {
    flex-shrink: 0;
    width: min(85vw, 44rem);
    scroll-snap-align: start;
    border: 1px solid var(--wg-border);
    border-radius: var(--radius-lg);
    background: var(--wg-surface);
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  .slide:hover,
  .slide:focus-within {
    border-color: var(--accent);
  }

  .slide__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .slide__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(0.92) brightness(1.04);
    transition:
      filter 0.5s ease,
      transform 0.7s ease;
  }

  .slide:hover .slide__media :global(img),
  .slide:focus-within .slide__media :global(img) {
    filter: grayscale(0) contrast(1) brightness(1);
    transform: scale(1.03);
  }

  .slide__tag {
    position: absolute;
    top: 1rem;
    right: 1rem;
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--accent);
    border-radius: var(--radius);
    background: rgb(from var(--wg-bg) r g b / 0.92);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    backdrop-filter: blur(4px);
  }

  .slide__body {
    padding: 1.25rem;
  }

  .slide__title {
    font-size: 1.125rem;
    text-transform: uppercase;
  }

  .slide__caption {
    margin-top: 0.375rem;
    font-size: 0.875rem;
    color: var(--wg-muted);
  }

  .strip__end {
    flex-shrink: 0;
    width: 1px;
  }

  .strip__hint {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--wg-faint);
  }

  @media (min-width: 900px) {
    .strip__hint {
      justify-content: flex-start;
      padding-inline: 2rem;
    }
  }
</style>
