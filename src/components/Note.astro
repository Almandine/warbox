---
interface Props {
  /** 'draft' marks unfinished content; 'info' is a normal aside. */
  tone?: 'draft' | 'info';
  label?: string;
}

const { tone = 'info', label = tone === 'draft' ? 'Draft' : 'Note' } = Astro.props;
---

<aside class:list={['note', `note--${tone}`]}>
  <span class="note__label">{label}</span>
  <div class="note__body"><slot /></div>
</aside>

<style>
  .note {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--wg-border);
    border-left-width: 3px;
    border-radius: var(--radius);
    background: rgb(from var(--wg-surface) r g b / 0.6);
    font-size: 0.9375rem;
  }

  .note--draft {
    border-left-color: var(--wg-highlight);
  }

  .note--info {
    border-left-color: var(--wg-accent-strong);
  }

  .note__label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  .note--draft .note__label {
    color: var(--wg-highlight);
  }

  .note--info .note__label {
    color: var(--wg-accent-strong);
  }

  .note__body {
    flex: 1 1 20rem;
    color: var(--wg-muted);
  }
</style>
