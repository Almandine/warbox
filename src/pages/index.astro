---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ScreenshotStrip, { type StripItem } from '../components/ScreenshotStrip.astro';
import { getScreenshots } from '../lib/screenshots';
import { getGamesByDate, getGamesBySeries, formatDate, lastTouched } from '../lib/games';

const games = await getGamesByDate();
const groups = await getGamesBySeries();

const available = games.filter((game) => game.data.status === 'available');
const newest = available[0];

// Every screenshot of every published companion, newest game first.
const seriesById = new Map(groups.map(({ series }) => [series.data.id, series]));
const stripItems: StripItem[] = available.flatMap((game) => {
  const series = seriesById.get(game.data.series);
  if (!series) return [];

  return getScreenshots(game.id, game.data.screenshots).map((shot) => ({
    image: shot.image,
    caption: shot.caption,
    gameTitle: game.data.title,
    gameId: game.id,
    seriesName: series.data.name,
    accent: series.data.accent,
  }));
});

const stats = [
  { icon: 'layers', tone: 'olive', label: 'Companions ready', value: String(available.length) },
  { icon: 'books', tone: 'amber', label: 'WDS series covered', value: String(groups.length) },
  { icon: 'cpu', tone: 'olive', label: 'Titles listed', value: String(games.length) },
  {
    icon: 'clock',
    tone: 'red',
    label: 'Last update',
    value: newest ? formatDate(lastTouched(newest)) : '—',
  },
] as const;
---

<Base>
  <section class="hero">
    <div class="wrap hero__inner">
      <p class="hero__badge">
        <span class="hero__pulse"></span>
        Catalog updated
      </p>

      <h1 class="hero__title">
        Game Companions<br />
        for Wargame Design Studio
      </h1>

      <p class="lead hero__lead">
        Free companion spreadsheets for WDS titles — unit data, orders of battle and victory
        conditions pulled out of the game and laid out so you can actually read them. Made by a
        player who got tired of squinting at the unit list.
      </p>

      <div class="hero__actions">
        <a class="btn" href="/games/">
          Browse the catalog
          <Icon name="arrow-right" size="1.1em" />
        </a>
        <a class="btn btn--ghost" href="/how-to-use/">New here? Start with the guide</a>
      </div>
    </div>
  </section>

  <section class="wrap">
    <dl class="stats panel">
      {
        stats.map((stat) => (
          <div class="stats__cell">
            <Icon name={stat.icon} size="1.75rem" class={`stats__icon stats__icon--${stat.tone}`} />
            <dt class="stats__label">{stat.label}</dt>
            <dd class="stats__value">{stat.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <ScreenshotStrip items={stripItems} />
</Base>

<style>
  .hero {
    position: relative;
    border-bottom: 1px solid var(--wg-border);
    padding-block: 6rem 7rem;
    overflow: hidden;
    background-color: var(--wg-bg);
    background-image:
      radial-gradient(ellipse 70% 90% at 15% 10%, rgb(from var(--wg-accent) r g b / 0.1), transparent 65%),
      radial-gradient(ellipse 80% 70% at 90% 100%, rgb(from var(--wg-border) r g b / 0.45), transparent 60%);
  }

  /* Operations-map grid, drawn over the tint so it stays legible. */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, rgb(from var(--wg-ink) r g b / 0.055) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(from var(--wg-ink) r g b / 0.055) 1px, transparent 1px);
    background-size: 40px 40px;
    mask-image: linear-gradient(to bottom, #000 0%, #000 65%, transparent 100%);
  }

  @media (min-width: 1024px) {
    .hero {
      padding-block: 9rem 10rem;
    }
  }

  .hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.75rem;
    margin-bottom: 1.5rem;
    border: 1px solid rgb(from var(--wg-alert) r g b / 0.35);
    border-radius: var(--radius);
    background: rgb(from var(--wg-alert) r g b / 0.15);
    color: var(--wg-alert);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
  }

  .hero__pulse {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--wg-alert);
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    50% {
      opacity: 0.35;
    }
  }

  .hero__title {
    font-size: clamp(2.25rem, 1.2rem + 4.5vw, 4.5rem);
    text-transform: uppercase;
    letter-spacing: -0.01em;
    margin-bottom: 1.5rem;
    text-wrap: balance;
  }

  .hero__lead {
    max-width: 46rem;
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 2.5rem;
    width: 100%;
  }

  @media (min-width: 640px) {
    .hero__actions {
      flex-direction: row;
      width: auto;
    }
  }

  /* --- Stat band: overlaps the hero edge like a clipboard laid on the map. --- */

  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: -2.5rem;
    position: relative;
    z-index: 10;
    box-shadow: 0 16px 32px -22px rgb(from var(--wg-emphasis) r g b / 0.45);
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .stats__cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 1.5rem 1rem;
    border-top: 1px solid var(--wg-border);
    border-left: 1px solid var(--wg-border);
  }

  /* Two-column layout: no rule above the first row, none left of the first column. */
  .stats__cell:nth-child(-n + 2) {
    border-top: 0;
  }

  .stats__cell:nth-child(odd) {
    border-left: 0;
  }

  /* Four-column layout: a single row, rules between cells only. */
  @media (min-width: 768px) {
    .stats__cell,
    .stats__cell:nth-child(odd) {
      border-top: 0;
      border-left: 1px solid var(--wg-border);
    }

    .stats__cell:first-child {
      border-left: 0;
    }
  }

  .stats__icon {
    margin-bottom: 0.5rem;
    transition: transform 0.2s ease;
  }

  .stats__cell:hover .stats__icon {
    transform: scale(1.12);
  }

  .stats__icon--olive {
    color: var(--wg-accent-strong);
  }
  .stats__icon--amber {
    color: var(--wg-highlight);
  }
  .stats__icon--red {
    color: var(--wg-alert);
  }

  .stats__label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--wg-muted);
  }

  .stats__value {
    margin: 0.25rem 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.75rem;
    color: var(--wg-ink);
    line-height: 1.1;
  }
</style>
