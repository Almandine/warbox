---
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import Icon from '../components/Icon.astro';
import SeriesCard from '../components/SeriesCard.astro';
import ScreenshotStrip, { type StripItem } from '../components/ScreenshotStrip.astro';
import LatestUpdates from '../components/LatestUpdates.astro';
import { getScreenshots } from '../lib/screenshots';
import { getGamesByDate, getSeriesOverview, formatDate, hrefOf, lastTouched } from '../lib/games';
import { SITE_NAME, SITE_TITLE } from '../consts';

const [games, overview] = await Promise.all([getGamesByDate(), getSeriesOverview()]);

const available = games.filter((game) => game.data.status === 'available');
const newest = available[0];

// Every screenshot of every published companion, newest game first.
const seriesById = new Map(overview.map(({ series }) => [series.data.id, series]));
const stripItems: StripItem[] = available.flatMap((game) => {
  const series = seriesById.get(game.data.series);
  if (!series) return [];

  return getScreenshots(game.id, game.data.screenshots).map((shot) => ({
    image: shot.image,
    caption: shot.caption,
    gameTitle: game.data.title,
    gameHref: hrefOf.game(game),
    seriesName: series.data.name,
    accent: series.data.accent,
  }));
});

const stats = [
  { icon: 'layers', tone: 'olive', label: 'Companions ready', value: String(available.length) },
  { icon: 'books', tone: 'amber', label: 'WDS series covered', value: String(overview.length) },
  { icon: 'cpu', tone: 'olive', label: 'Titles listed', value: String(games.length) },
  {
    icon: 'clock',
    tone: 'red',
    label: 'Last update',
    value: newest ? formatDate(lastTouched(newest)) : '—',
  },
] as const;

// The three kinds of material the site publishes — the "what you get" band.
const offerings = [
  {
    icon: 'file-text',
    title: 'Game Companions',
    body: 'Custom-built Excel scenario track sheets designed to log your progress, record your outcomes, and analyze your campaigns scenario by scenario.',
  },
  {
    icon: 'image',
    title: 'Visual Assets',
    body: 'Downloadable materials like custom-designed printable user manual covers.',
  },
  {
    icon: 'books',
    title: 'Curated Intelligence',
    body: 'Historical references, recommended books, insightful articles, and YouTube briefings to deepen your immersion and historical understanding.',
  },
] as const;
---

<Base>
  <Cover slot="cover" />

  <section class="intro">
    <div class="wrap">
      <h1 class="intro__title">Welcome to {SITE_TITLE}</h1>
      <p class="intro__tagline">Where history becomes playable</p>
      <p class="lead intro__lead">
        A dedicated resource and command hub for historical hex-and-counter wargames. To me, these
        games are much more than just digital simulations — they are playable history books. They
        offer a unique opportunity to step into the boots of historical commanders, explore
        real-world campaigns, and test your tactical acumen on authentic battlefields.
      </p>
      <a class="btn btn--ghost intro__cta" href="/how-to-use/">New here? Start with the guide</a>
    </div>
  </section>

  <section class="wrap">
    <dl class="stats panel">
      {
        stats.map((stat) => (
          <div class="stats__cell">
            <Icon name={stat.icon} size="1.75rem" class={`stats__icon stats__icon--${stat.tone}`} />
            <dt class="stats__label">{stat.label}</dt>
            <dd class="stats__value">{stat.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="wrap section">
    <h2 class="section-title">
      <Icon name="compass" size="1em" class="mission__icon" /> Order on the battlefield
    </h2>
    <div class="section-rule"></div>

    <p class="mission__body">
      Every successful campaign requires precise logistics and clear information. I created this site
      to bring a structured, analytical approach to our favorite wargames. Whether you are navigating
      massive operational fronts or gritty tactical firefights, you will find meticulously crafted
      tools here to enhance your gameplay.
    </p>

    <h3 class="mission__subtitle">What you will find inside the {SITE_NAME}</h3>

    <ul class="mission__grid">
      {
        offerings.map((item) => (
          <li class="mission__card panel">
            <Icon name={item.icon} size="1.75rem" class="mission__card-icon" />
            <h4 class="mission__card-title">{item.title}</h4>
            <p class="mission__card-body">{item.body}</p>
          </li>
        ))
      }
    </ul>

    <p class="mission__closer">
      Grab your digital counters, check your supply lines, and dive into the campaigns! The hexes are
      waiting.
    </p>
  </section>

  <section class="wrap section section--tight">
    <div class="series__head">
      <h2 class="section-title">
        <Icon name="layers" size="1em" class="series__icon" /> Pick a series
      </h2>
      <a class="series__all" href="/series/">
        Every title <Icon name="caret-right" size="0.85em" />
      </a>
    </div>
    <div class="section-rule"></div>

    <div class="series__grid">
      {
        overview.map((entry) => (
          <SeriesCard
            series={entry.series}
            games={entry.games.length}
            companions={entry.companions}
            resources={entry.resources}
          />
        ))
      }
    </div>
  </section>

  <LatestUpdates />
  <ScreenshotStrip items={stripItems} />
</Base>

<style>
  /* Deliberately restrained: the cover band above the nav carries the weight,
     so the page gets to its content — the series cards — quickly. */
  .intro {
    position: relative;
    border-bottom: 1px solid var(--wg-border);
    padding-block: 3rem 4.5rem;
    overflow: hidden;
    background-color: var(--wg-bg);
    background-image: radial-gradient(
      ellipse 70% 90% at 15% 10%,
      rgb(from var(--wg-accent) r g b / 0.1),
      transparent 65%
    );
  }

  /* Operations-map grid, drawn over the tint so it stays legible. */
  .intro::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: var(--tex-hex);
    background-size: var(--tex-hex-size);
    mask-image: linear-gradient(to bottom, #000 0%, #000 65%, transparent 100%);
  }

  .intro > * {
    position: relative;
  }

  .intro__title {
    font-size: clamp(1.75rem, 1.1rem + 2.6vw, 2.75rem);
    text-transform: uppercase;
    letter-spacing: -0.01em;
    margin-bottom: 0.75rem;
    max-width: 24ch;
    text-wrap: balance;
  }

  /* Unit motto under the wordmark — small, stamped, out of the h1's way. */
  .intro__tagline {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--wg-accent-strong);
    margin-bottom: 1.75rem;
  }

  .intro__lead {
    max-width: 46rem;
  }

  .intro__cta {
    margin-top: 2rem;
  }

  /* --- Stat band: overlaps the intro edge like a clipboard laid on the map. --- */

  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: -2.5rem;
    position: relative;
    z-index: 10;
    box-shadow: 0 16px 32px -22px rgb(from var(--wg-emphasis) r g b / 0.45);
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .stats__cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 1.5rem 1rem;
    border-top: 1px solid var(--wg-border);
    border-left: 1px solid var(--wg-border);
  }

  /* Two-column layout: no rule above the first row, none left of the first column. */
  .stats__cell:nth-child(-n + 2) {
    border-top: 0;
  }

  .stats__cell:nth-child(odd) {
    border-left: 0;
  }

  /* Four-column layout: a single row, rules between cells only. */
  @media (min-width: 768px) {
    .stats__cell,
    .stats__cell:nth-child(odd) {
      border-top: 0;
      border-left: 1px solid var(--wg-border);
    }

    .stats__cell:first-child {
      border-left: 0;
    }
  }

  .stats__icon {
    margin-bottom: 0.5rem;
    transition: transform 0.2s ease;
  }

  .stats__cell:hover .stats__icon {
    transform: scale(1.12);
  }

  .stats__icon--olive {
    color: var(--wg-accent-strong);
  }
  .stats__icon--amber {
    color: var(--wg-highlight);
  }
  .stats__icon--red {
    color: var(--wg-alert);
  }

  .stats__label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--wg-muted);
  }

  .stats__value {
    margin: 0.25rem 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.75rem;
    color: var(--wg-ink);
    line-height: 1.1;
  }

  /* --- Mission: what the site is for, and what it hands you --- */

  .mission__icon {
    color: var(--wg-accent-strong);
  }

  .mission__body {
    max-width: 68ch;
    margin-top: 1.75rem;
  }

  .mission__subtitle {
    margin-top: 2.75rem;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .mission__grid {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1.5rem;
    margin-top: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), 1fr));
  }

  .mission__card {
    padding: 1.5rem;
  }

  .mission__card-icon {
    color: var(--wg-accent-strong);
    margin-bottom: 0.75rem;
  }

  .mission__card-title {
    font-size: 1.0625rem;
    margin-bottom: 0.5rem;
  }

  .mission__card-body {
    font-size: 0.9375rem;
    color: var(--wg-muted);
  }

  /* Sign-off: reads as a stamped order rather than another paragraph. */
  .mission__closer {
    margin-top: 2.5rem;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    letter-spacing: 0.01em;
    color: var(--wg-ink);
    border-left: 4px solid var(--wg-alert);
    padding-left: 1rem;
    max-width: 52ch;
  }

  /* --- Series cards --- */

  /* Follows the mission block, which already provides the gap above. */
  .section--tight {
    padding-top: 0;
  }

  .series__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .series__icon {
    color: var(--wg-accent-strong);
  }

  .series__all {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
    color: var(--wg-muted);
    white-space: nowrap;
  }

  .series__all:hover {
    color: var(--wg-ink);
  }

  .series__grid {
    display: grid;
    gap: 1.5rem;
    margin-top: 2rem;
    grid-template-columns: repeat(auto-fill, minmax(min(21rem, 100%), 1fr));
  }
</style>
