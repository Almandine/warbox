---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Note from '../../components/Note.astro';
import type { Game } from '../../lib/games';

export async function getStaticPaths() {
  const games = await getCollection('games');
  return games.map((game) => ({ params: { id: game.id }, props: { game } }));
}

interface Props {
  game: Game;
}

const { game } = Astro.props;
---

<Base title={game.data.title} description={game.data.description}>
  <PageHeader eyebrow="Companion" title={game.data.title} lead={game.data.description} />
  <div class="wrap section">
    <Note tone="draft">
      Step 3 builds this page: download button, screenshot gallery and companion details.
    </Note>
  </div>
</Base>
