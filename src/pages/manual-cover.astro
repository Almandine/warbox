---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Note from '../components/Note.astro';
import DownloadButton from '../components/DownloadButton.astro';

/**
 * Formats of the Panzer Campaigns manual cover. Drop the matching file into
 * public/downloads/pc-manual-cover/ and it goes live — the button reads its own
 * size, and shows a disabled state until the file exists.
 */
const formats = [
  {
    file: 'panzer-campaigns-manual-cover.pdf',
    label: 'PDF — print ready',
    note: 'A4, 300 dpi, with bleed. This is the one to send to a print shop.',
  },
  {
    file: 'panzer-campaigns-manual-cover-a4.png',
    label: 'PNG — A4',
    note: 'For printing at home, or for a quick look before you commit to paper.',
  },
  {
    file: 'panzer-campaigns-manual-cover-web.jpg',
    label: 'JPG — screen',
    note: 'Small file, good enough for a forum post or a wallpaper.',
  },
];
---

<Base
  title="Manual cover"
  description="A custom cover for the Panzer Campaigns user manual — free to download and print, in print-ready and screen formats."
>
  <PageHeader
    eyebrow="Download"
    title="Manual cover"
    icon="image"
    lead="A custom cover for the Panzer Campaigns user manual. Free, in a few formats, for anyone who prints their manuals."
  />

  <div class="wrap section layout">
    <div class="prose">
      <Note tone="draft">
        Draft copy and no files yet. The download buttons stay disabled until the artwork is added
        to <code>public/downloads/pc-manual-cover/</code>.
      </Note>

      <h2>Why</h2>
      <p>
        Printing the manual makes a long campaign much easier to sit down with — but the printout
        deserves a front page that looks like it belongs on a shelf next to the boxed games. This
        cover is drawn for exactly that.
      </p>

      <h2>Printing it</h2>
      <p>
        The PDF is the one to use. It is A4 at 300 dpi with bleed, so a print shop can trim it
        without cutting into the artwork. If you are printing at home, the PNG is easier to feed
        into a normal printer dialog.
      </p>

      <h2>What you may do with it</h2>
      <p>
        Print it, share it, put it in a binder. It is fan art for a game series made by other
        people: do not sell it, and do not present it as official Wargame Design Studio material.
      </p>
    </div>

    <aside class="formats">
      <h2 class="formats__title">Formats</h2>
      {
        formats.map((format) => (
          <div class="formats__row">
            <DownloadButton
              href={`/downloads/pc-manual-cover/${format.file}`}
              label={format.label}
              variant="subtle"
            />
            <p class="formats__note">{format.note}</p>
          </div>
        ))
      }
    </aside>
  </div>
</Base>

<style>
  .layout {
    display: grid;
    gap: 3rem;
    align-items: start;
  }

  @media (min-width: 900px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 22rem;
    }
  }

  .formats__title {
    font-size: 1.125rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding-bottom: 0.625rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--wg-border);
    color: var(--wg-muted);
  }

  .formats__row + .formats__row {
    margin-top: 1.5rem;
  }

  .formats__note {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    color: var(--wg-muted);
  }
</style>
