---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Position unknown" description="The page you were looking for does not exist.">
  <div class="wrap lost">
    <p class="eyebrow">Error 404</p>
    <h1>Position unknown</h1>
    <div class="section-rule"></div>
    <p class="lost__text">
      No map sheet covers this grid reference. The page may have been moved or never existed.
    </p>
    <a class="btn" href="/">Return to base <Icon name="arrow-right" size="1.1em" /></a>
  </div>
</Base>

<style>
  .lost {
    padding-block: 7rem;
    max-width: 42rem;
  }

  .lost h1 {
    font-size: clamp(2rem, 1.4rem + 3vw, 3rem);
    text-transform: uppercase;
    margin-top: 0.5rem;
  }

  .lost__text {
    margin-block: 1.5rem 2.5rem;
    color: var(--wg-muted);
  }
</style>
