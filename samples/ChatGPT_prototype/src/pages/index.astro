---
import Base from '../layouts/Base.astro';
import LatestUpdates from '../components/LatestUpdates.astro';
---
<Base description="Fan-made, practical companions for Wargame Design Studio games.">
  <section class="shell hero">
    <p class="eyebrow">Wargame Design Studio companions</p>
