---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const categories = ['aar', 'ai', 'tips', 'misc'];
---
<Base title="Articles" description="Warbox articles about computer wargaming.">
  <div class="shell prose"><h1>Articles</h1><div class="chips" aria-label="Article categories">{categories.map((category) => <a href={`#${category}`}>{category.toUpperCase()}</a>)}</div>{articles.length ? <div class="article-list">{articles.map((article) => <article id={article.data.category}><p class="meta">{article.data.category.toUpperCase()} · {article.data.date.toLocaleDateString('en', { year: 'numeric', month: 'long', day: 'numeric' })}</p><h2><a href={`/articles/${article.id}/`}>{article.data.title}</a></h2><p>{article.data.description}</p></article>)}</div> : <p class="draft-note">Articles will appear here once the first piece is published.</p>}</div>
</Base>
