---
import { getCollection } from 'astro:content';
const articles = await getCollection('articles', ({ data }) => !data.draft);
const path = Astro.url.pathname;
const nav = [
  ['/games/', 'Games'], ['/how-to-use/', 'How to use'], ['/manual-cover/', 'Manual cover'],
  ['/about/', 'About'], ['/contact/', 'Contact'],
] as const;
if (articles.length) nav.splice(1, 0, ['/articles/', 'Articles']);
---
<header class="site-header">
  <div class="shell header-inner">
    <a class="wordmark" href="/" aria-label="Warbox home">Warbox</a>
    <nav aria-label="Main navigation">
      {nav.map(([href, label]) => <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>)}
    </nav>
  </div>
</header>
